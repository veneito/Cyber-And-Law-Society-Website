# Discord sign-in for the live case: the bot's /play command gives a one-time code. Copy into private .env; never commit.
# CASE_BOT_SECRET must be the same value on the site's machine and the bot's machine (long random string).
CASE_BOT_SECRET=
DISCORD_GUILD_ID=
DISCORD_BOT_TOKEN=
# Only the bot needs this, if the site is not at the default:
# CASE_SITE_URL=https://cybernlaw.grenudo.dev
# Live leaderboard: numeric ID of the #wellington-case channel (needs DISCORD_BOT_TOKEN above on the site's machine).
# The bot needs View Channel, Send Messages and Embed Links there.
CASE_LEADERBOARD_CHANNEL_ID=
